# Environment template for Cinc Console.
# Copy this file to .env.local for local development and fill in real values.

# Base URL of the Cinc server (must include scheme)
CINC_SERVER_URL=https://cinc.example.com

# WebUI signing key: set ONE of CINC_WEBUI_KEY_FILE or CINC_WEBUI_KEY
CINC_WEBUI_KEY_FILE=/path/to/webui_priv.pem
# CINC_WEBUI_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 32+ character secret used to encrypt session cookies: set ONE of
# SESSION_SECRET or SESSION_SECRET_FILE. One trailing newline is stripped from
# the file, so `echo secret > file` works.
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
# SESSION_SECRET_FILE=/run/secrets/session_secret

# Optional CA bundle: set either inline or by file path
CINC_CA_CERT_FILE=
# CINC_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional: skip TLS verification (dev/test only)
CINC_SSL_NO_VERIFY=false

# Optional: session lifetime in seconds (default: 28800)
SESSION_TTL_SECONDS=28800

# Optional: Secure flag on the session cookie. Unset means "on in production,
# off in development", which is what you want for any HTTPS deployment. Set it
# to false only for a deliberate plain-HTTP deployment — it is deliberately not
# inferred from X-Forwarded-Proto, which a client can send.
# SESSION_COOKIE_SECURE=true

# Optional: API version header sent to server (default: 16.0.0)
CHEF_VERSION=16.0.0

# Optional: globally privileged actor for /authenticate_user on servers
# that require global create permissions (for example: pivotal)
CINC_AUTH_ACTOR=

# Auth mode: "local" (default) asks the Cinc server's own /authenticate_user;
# "ldap" verifies credentials against an external directory instead. Either
# way, the submitted username must already exist as a Cinc user object.
AUTH_MODE=local

# Required when AUTH_MODE=ldap
# LDAP_URL=ldaps://dc1.example.com:636
# LDAP_BASE_DN=dc=example,dc=com

# Optional: service-account bind for the search phase. Set both or neither
# (some directories allow an anonymous search bind).
# LDAP_BIND_DN=cn=svc-cinc-console,ou=service-accounts,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BIND_PASSWORD_FILE=/path/to/ldap-bind-password

# Optional: search filter template. {{username}} is replaced with the
# escaped, submitted username. Default below suits OpenLDAP; Active
# Directory typically uses (sAMAccountName={{username}}).
# LDAP_USER_FILTER=(uid={{username}})

# Optional: search timeout in milliseconds (default: 5000)
# LDAP_SEARCH_TIMEOUT_MS=5000

# Optional: skip TLS verification against the directory (dev/test only)
# LDAP_TLS_NO_VERIFY=false

# Optional CA bundle for the directory, separate from CINC_CA_CERT above
# LDAP_CA_CERT_FILE=/path/to/ldap-ca.pem
# LDAP_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
