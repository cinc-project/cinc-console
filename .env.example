# Environment template for Cinc Console.
# Copy this file to .env.local for local development and fill in real values.

# Base URL of the Cinc server (must include scheme)
CINC_SERVER_URL=https://cinc.example.com

# WebUI signing key: set ONE of CINC_WEBUI_KEY_FILE or CINC_WEBUI_KEY
CINC_WEBUI_KEY_FILE=/path/to/webui_priv.pem
# CINC_WEBUI_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 32+ character secret used to encrypt session cookies
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Optional CA bundle: set either inline or by file path
CINC_CA_CERT_FILE=
# CINC_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional: skip TLS verification (dev/test only)
CINC_SSL_NO_VERIFY=false

# Optional: session lifetime in seconds (default: 28800)
SESSION_TTL_SECONDS=28800

# Optional: Secure flag on the session cookie. Unset means "on in production,
# off in development", which is what you want for any HTTPS deployment. Set it
# to false only for a deliberate plain-HTTP deployment — it is deliberately not
# inferred from X-Forwarded-Proto, which a client can send.
# SESSION_COOKIE_SECURE=true

# Optional: API version header sent to server (default: 16.0.0)
CHEF_VERSION=16.0.0

# Optional: globally privileged actor for /authenticate_user on servers
# that require global create permissions (for example: pivotal)
CINC_AUTH_ACTOR=
